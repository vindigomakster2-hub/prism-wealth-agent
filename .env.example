# Copy to .env (same folder) and fill in what you need. Everything is optional:
# without keys Abanq runs fully offline with the rules-based agent and a simulated bank feed.

# AI agent: chat, triage of unclear transactions, receipt photos (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Receipt photos need a Groq model that accepts images; leave empty to turn photo scanning off
# GROQ_VISION_MODEL=
# ABANQ_LLM=off

# Telegram bot for questions and alerts (setup steps in README → "Telegram bot")
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Real EU bank connections via GoCardless Bank Account Data (PSD2 AIS)
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Open the app to other devices (default: this computer only). Comma-separated host names or IPs;
# an entry starting with "." also matches subdomains. See README → "Open it from another laptop".
# ABANQ_ALLOWED_HOSTS=192.168.1.139
# ABANQ_ALLOWED_HOSTS=.trycloudflare.com

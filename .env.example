# Copy to .env (same folder) and fill in what you need. Everything is optional:
# without keys Halo runs fully offline with the rules-based agent and a simulated bank feed.

# AI agent: chat, triage of unclear transactions, receipt photos (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Receipt photos need a Groq model that accepts images; leave empty to turn photo scanning off
# GROQ_VISION_MODEL=
# HALO_LLM=off

# Telegram bot for questions and alerts (setup steps in README → "Telegram bot")
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Real EU bank connections via GoCardless Bank Account Data (PSD2 AIS)
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Extra host names allowed to reach the API, comma-separated (default: localhost only)
# HALO_ALLOWED_HOSTS=
